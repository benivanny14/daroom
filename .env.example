# Database. Local dev uses the bundled cluster on port 5434; production uses a
# hosted PostgreSQL (e.g. Supabase session pooler: port 5432, username
# "postgres.<project-ref>"). Supabase pooler certificates are verified against
# the pinned root CA embedded in lib/prisma.ts and prisma/seed.cjs — no extra
# TLS variable is needed.
DATABASE_URL="postgresql://darroom:change-this-password@127.0.0.1:5434/darroom?schema=public"
# Optional: runtime-only connection string. On Supabase use the transaction
# pooler (port 6543) here so serverless functions do not exhaust the session
# pooler's ~15 client limit; migrations still run against DATABASE_URL.
# DATABASE_POOL_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Supabase project coordinates (optional; the app talks to Postgres through
# Prisma, these are used for Supabase-hosted services and dashboards).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
# Bucket used for listing photos when Supabase Storage is configured.
SUPABASE_STORAGE_BUCKET="darroom"

# Required to send email in production (Resend). Do not commit real values.
# `onboarding@resend.dev` is Resend's sandbox sender and only delivers to the
# Resend account owner; verify a domain at resend.com/domains and use an address
# on that domain before expecting verification/reset emails for real users.
RESEND_API_KEY=""
EMAIL_FROM="DarRoom <accounts@example.com>"

# SMS for phone OTP verification (Beem-compatible JSON API). Locally, missing
# values print the code to the server console instead of sending an SMS.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# Number of open reports within 30 days before a listing is auto-flagged.
REPORT_FLAG_THRESHOLD=3

# Selcom merchant credentials and environment URL from Selcom.
SELCOM_BASE_URL=""
SELCOM_API_KEY=""
SELCOM_API_SECRET=""
SELCOM_VENDOR=""
SELCOM_CREATE_ORDER_PATH="/v1/checkout/create-order"

# SonicPesa mobile-money gateway (M-Pesa, Tigo Pesa, Airtel Money, Halopesa).
# Get the access and secret keys from SonicPesa Dashboard -> API Settings.
# The secret key is also used to verify the X-SonicPesa-Signature webhook.
SONICPESA_ACCESS_KEY=""
SONICPESA_SECRET_KEY=""
SONICPESA_BASE_URL="https://api.sonicpesa.com"

# S3-compatible object storage (AWS S3, Cloudflare R2, etc.). Optional: when
# the Supabase values above are set, listing photos go to Supabase Storage
# instead. MEDIA_PUBLIC_BASE_URL overrides the public photo URL prefix.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""

# Protect POST /api/cron/subscriptions. Generate a unique random secret.
CRON_SECRET=""

# Required to seed an administrator. Never use these as default credentials.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PHONE=""
ADMIN_PASSWORD=""

# Set to "true" only in local development to add sample agents and listings.
# Leave unset in production so the database stays clean.
SEED_DEMO_DATA="false"

# M-Pesa credentials (Tanzania)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""

# Tigo Pesa credentials
TIGO_PESA_API_KEY=""
TIGO_PESA_API_SECRET=""
TIGO_PESA_MERCHANT_ID=""

# Airtel Money credentials
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Development-only fallbacks. Do not enable these in production.
# PAYMENTS_MOCK simulates a successful Selcom checkout locally.
PAYMENTS_MOCK="false"

# ID verification service (optional)
ID_VERIFICATION_API_KEY=""
